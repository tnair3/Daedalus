<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =================================================================== -->
    <!-- Preview & Global Defaults                                           -->
    <!-- =================================================================== -->
    
    <Design.PreviewWith>
        <Border Padding="20" Background="{StaticResource TopBarBackground}">
            <Button Content="Hello World"/>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
    </Style>

    <Style Selector="PathIcon">
        <Setter Property="Width" Value="14"/>
    </Style>

    <Style Selector="Label.sidebar">
        <Setter Property="Padding" Value="10, 0, 0, 0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <Style Selector="TextBlock.upToDate">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- =================================================================== -->
    <!-- LAYOUT & CONTAINER BORDERS                                          -->
    <!-- =================================================================== -->

    <Style Selector="Border.tableHeader">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="12 12 0 0"/>
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorColour}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0 10 0 0"/>
    </Style>

    <Style Selector="Border.appVersions">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- =================================================================== -->
    <!-- General Button                                                      -->
    <!-- =================================================================== -->

    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- =================================================================== -->
    <!-- Action & Control Buttons                                            -->
    <!-- =================================================================== -->

    <!-- Create Button -->
    <Style Selector="Button.createButton">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource ApplicationAccent}"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    
    <Style Selector="Button.createButton:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource ApplicationAccentAlt}"/>
    </Style>
    
    <Style Selector="Button.createButton:pressed /template/ ContentPresenter">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource ApplicationAccentDark}"/>
    </Style>

    <!-- Update Button -->
    <Style Selector="Button.updateButton">
        <Setter Property="Background" Value="{StaticResource AccentButtonBackground}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Content" Value="Update now"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="14,6"/>
    </Style>
    
    <Style Selector="Button.updateButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentButtonBackgroundPointerOver}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryHoverText}"/>
    </Style>
    
    <Style Selector="Button.updateButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentButtonBackgroundPressed}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryHoverText}"/>
    </Style>

    <!-- Close Button -->
    <Style Selector="Button.closeButton">
        <Setter Property="Background" Value="{StaticResource StatusError}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="Button.closeButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource StatusError}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    
    <Style Selector="Button.closeButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource StatusError}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Back Button -->
    <Style Selector="Button.backButton">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.backButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
        <Setter Property="Foreground" Value="{StaticResource ApplicationAccentAlt}"/>
    </Style>

    <Style Selector="Button.backButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
        <Setter Property="Foreground" Value="{StaticResource ApplicationAccentAlt}"/>
        <Setter Property="RenderTransform" Value="scale(0.92)"/>
    </Style>

    <!-- Refresh Button -->
    <Style Selector="Button.refreshButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>
    
    <Style Selector="Button.refreshButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ApplicationAccentAlt}"/>
    </Style>
    
    <Style Selector="Button.refreshButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ApplicationAccentAlt}"/>
        <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>

    <!-- Context Menu Button -->
    <Style Selector="Button.contextMenuButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>
    
    <Style Selector="Button.contextMenuButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryHoverText}"/>
    </Style>
    
    <Style Selector="Button.contextMenuButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryHoverText}"/>
        <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>

    <!-- Path Picker Button -->
    <Style Selector="Button.pathPickerButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.pathPickerButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ApplicationAccentAlt}"/>
    </Style>

    <Style Selector="Button.pathPickerButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ApplicationAccentAlt}"/>
        <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>

    <!-- =================================================================== -->
    <!-- Project Components                                                  -->
    <!-- =================================================================== -->

    <Style Selector="Border.projectButtonBackground">
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="SineEaseInOut"/>
            </Transitions>
        </Setter>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.projectButton">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    
    <Style Selector="Button.projectButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Button.projectButton:pointerover Border.projectButtonBackground">
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <Style Selector="Button.projectButton:pressed Border.projectButtonBackground">
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style Selector="Button.loadProjectButton">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>
        
    <Style Selector="Button.loadProjectButton[Tag=True] /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource PrimaryHoverText}"/>
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
    </Style>
    
    <Style Selector="Button.loadProjectButton:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource PrimaryHoverText}"/>
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
    </Style>
    
    <Style Selector="Button.loadProjectButton:pressed /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource PrimaryHoverText}"/>
        <Setter Property="Background" Value="{StaticResource ApplicationAccentSubtle}"/>
    </Style>

    <Style Selector="Button.creatingProject">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="Button.creatingProject:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ApplicationAccentAlt}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    
    <Style Selector="Button.creatingProject:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ApplicationAccentDark}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- =================================================================== -->
    <!-- Module Chip Components                                              -->
    <!-- =================================================================== -->

    <Style Selector="Button.moduleChip">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorColour}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.moduleChip:pointerover /template/ Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    
    <Style Selector="Button.moduleChip:pressed /template/ Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
    </Style>

    <Style Selector="Border.moduleChipIcon">
        <Setter Property="Background" Value="{StaticResource ApplicationAccentSubtle}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
    </Style>

    <Style Selector="Border.moduleChipIcon PathIcon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource ApplicationAccentAlt}"/>
    </Style>

    <Style Selector="TextBlock.chipTitle">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
    </Style>

    <Style Selector="TextBlock.chipSubtitle">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
    </Style>

    <Style Selector="Border.chipStatusDot">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="999"/>
    </Style>

    <Style Selector="Border.chipStatusDot.upToDate">
        <Setter Property="Background" Value="{StaticResource StatusSuccess}"/>
    </Style>

    <Style Selector="Border.chipStatusDot.updateAvailable">
        <Setter Property="Background" Value="{StaticResource StatusWarning}"/>
    </Style>
    
    <Style Selector="Border.chipStatusDot.serverError">
        <Setter Property="Background" Value="{StaticResource StatusError}"/>
    </Style>

    <Style Selector="Button.chipUpdateButton">
        <Setter Property="Background" Value="{StaticResource ApplicationAccent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Content" Value="Update"/>
    </Style>

    <Style Selector="Button.chipUpdateButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ApplicationAccentAlt}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.chipUpdateButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ApplicationAccentDark}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- =================================================================== -->
    <!-- Book Components                                                     -->
    <!-- =================================================================== -->

    <Style Selector="Border.book">
        <Setter Property="Width" Value="140"/>
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="4 12 12 4"/>
        <Setter Property="BoxShadow" Value="5 5 15 0 #60000000"/>
        <Setter Property="BorderBrush" Value="{StaticResource ApplicationAccent}"/>
        <Setter Property="BorderThickness" Value="4 0 0 0"/>
    </Style>

    <Style Selector="Button.book">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    
    <Style Selector="Button.book:pointerover /template/ ContentPresenter">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    
    <Style Selector="Button.book:pressed /template/ ContentPresenter">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="TextBlock.bookTitle">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0, 10"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="ScrollViewer.booksView">
        <Setter Property="Padding" Value="0,0,0,15"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>
    
    <Style Selector="ScrollViewer.booksView /template/ ScrollBar#PART_HorizontalScrollBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <Style Selector="ScrollViewer.booksView /template/ ScrollBar#PART_HorizontalScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{StaticResource PrimaryText}"/>
        <Setter Property="Opacity" Value="0.2"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <Style Selector="ScrollViewer.booksView /template/ ScrollBar#PART_HorizontalScrollBar:pointerover /template/ Thumb">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <!-- =================================================================== -->
    <!-- Autocomplete Box                                                    -->
    <!-- =================================================================== -->

    <Style Selector="AutoCompleteBox.searchBox">
        <Setter Property="Background" Value="{StaticResource AutoCompleteBackground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="AutoCompleteBox.searchBox /template/ TextBox#PART_TextBox">
        <Setter Property="PlaceholderText" Value="Search"/>
        <Setter Property="SelectionBrush" Value="{StaticResource ApplicationAccent}"/>
        <Setter Property="InnerLeftContent">
            <Template>
                <PathIcon Data="{StaticResource Search}" Width="15" Height="15" Margin="10 0 0 0" VerticalAlignment="Center"/>
            </Template>
        </Setter>
    </Style>

    <Style Selector="AutoCompleteBox.searchBox /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement,
                    AutoCompleteBox.searchBox /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource AutoCompleteBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ApplicationAccent}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="AutoCompleteBox.searchBox /template/ Popup#PART_Popup Border">
        <Setter Property="Background" Value="{StaticResource AutoCompleteBackground}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="AutoCompleteBox.searchBox /template/ TextBox#PART_TextBox:focus /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <!-- =================================================================== -->
    <!-- Listbox                                                             -->
    <!-- =================================================================== -->

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBox /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/> 
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="ListBoxItem /template/ Border">
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,8"/> 
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    
    <Style Selector="ListBoxItem /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryHoverText}"/>
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ApplicationAccentSubtle}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryHoverText}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ApplicationAccentMuted}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryHoverText}"/>
    </Style>

    <Style Selector="ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ApplicationAccentAlt}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

</Styles>