<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DaedalusLauncher.Views.LearnView">
    
    <Grid Background="{StaticResource PrimaryBackground}">
        <Border Padding="10">
            <Grid RowDefinitions="Auto *">
                <!-- Page Header -->
                <Grid Grid.Row="0" ColumnDefinitions="* Auto">
                    <TextBlock Grid.Column="0" Text="Learn" Classes="heading"/>
                </Grid>
                
                <!-- Main Content -->
                <ScrollViewer Grid.Row="1">
                    <TextBlock Text="Nothing to learn yet..." VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    
</UserControl>
