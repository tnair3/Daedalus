<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DaedalusLauncher.Views.LearnView"
             x:DataType="vm:LearnViewModel">
    
    <!-- Scroll Viewer Template -->
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="ShelfPanelTemplate">
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,10"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="BookItemTemplate" x:DataType="vm:BookViewModel">
            <Button Command="{Binding OpenBookCommand}" Classes="book">
                <StackPanel Width="140">
                    <Border Classes="book">
                        <Grid RowDefinitions="*, 35" Margin="12 16 12 0">
                            <StackPanel Grid.Row="0" Spacing="10" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="White" 
                                           TextWrapping="Wrap" MaxLines="2" LineHeight="20" TextTrimming="CharacterEllipsis"/>
                                <Rectangle Height="1" Fill="White" Opacity="0.2" HorizontalAlignment="Left" Width="40"/>
                                <TextBlock Text="{Binding Author}" FontSize="12" FontWeight="Light" 
                                           Foreground="{DynamicResource PrimaryText}" Opacity="0.7" 
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                    Padding="6 2" Background="{DynamicResource ApplicationAccentAlt}" 
                                    CornerRadius="4" Opacity="0.4">
                                <TextBlock Text="{Binding Version}" FontSize="9" Foreground="White" 
                                           FontWeight="SemiBold" Opacity="1.0"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource PrimaryBackground}">
        <Border Padding="10">
            <Grid RowDefinitions="Auto *">
                <!-- Page Header -->
                <Grid Grid.Row="0" ColumnDefinitions="* Auto">
                    <TextBlock Grid.Column="0" Text="Learn" Classes="heading"/>
                </Grid>
                
                <!-- Main Content -->
                <Grid Grid.Row="1" RowDefinitions="* *">
                    <!-- Application Basics -->
                    <Grid Grid.Row="0" RowDefinitions="Auto *" Margin="10, 0, 10, 5">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Label Content="Application Basics" Foreground="{DynamicResource PrimaryText}"/>
                            <Rectangle Grid.Column="1" Height="1" Fill="{DynamicResource PrimaryText}" Opacity="0.1"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Classes="booksView" PointerWheelChanged="OnPointerWheelChanged">
                            <ItemsControl ItemsSource="{Binding ApplicationBooks}" ItemsPanel="{StaticResource ShelfPanelTemplate}" ItemTemplate="{StaticResource BookItemTemplate}" />
                        </ScrollViewer>
                    </Grid>
    
                    <!-- Software Architecture -->
                    <Grid Grid.Row="1" RowDefinitions="Auto *" Margin="10, 0, 10, 0">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Label Content="Software Architecture" Foreground="{DynamicResource PrimaryText}"/>
                            <Rectangle Grid.Column="1" Height="1" Fill="{DynamicResource PrimaryText}" Opacity="0.1"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Classes="booksView" PointerWheelChanged="OnPointerWheelChanged">
                            <ItemsControl ItemsSource="{Binding SoftwareBooks}" ItemsPanel="{StaticResource ShelfPanelTemplate}" ItemTemplate="{StaticResource BookItemTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    
</UserControl>
