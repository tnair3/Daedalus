<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:DaedalusLauncher.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ProjectsViewModel"
             x:Class="DaedalusLauncher.Views.ProjectsView">
    
    <Grid Background="{StaticResource PrimaryBackground}">
        <Border Padding="10" Grid.IsSharedSizeScope="True">
            <Grid RowDefinitions="Auto *">
                <!-- Page Header -->
                <StackPanel Grid.Row="0">
                    <!-- Page Title, Search Bar, and Create New Button-->
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Projects" Classes="heading"/>
                
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10" Spacing="15">
                            <AutoCompleteBox Classes="searchBox" VerticalAlignment="Center" CornerRadius="20" Width="250"/>
                            
                            <Button Background="Green" CornerRadius="12" Classes="createButton" Command="{Binding OpenCreateProjectWindowCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource Add}"/>
                                    <Label Content="Create New"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
            
                    <!-- Projects Table Header Row -->
                    <Border Classes="tableHeader">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FavoriteCol"/>   <!-- Favorite Star Column -->
                                <ColumnDefinition Width="*"/>                                    <!-- Main Name Column -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="VersionCol"/>    <!-- Engine Version -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DateCol"/>       <!-- Last Modified -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="OptionsCol"/>    <!-- Options Menu Column -->
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="40">
                                <PathIcon Data="{StaticResource StarFilled}" Width="14" Opacity="0.5" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="Name" VerticalAlignment="Center" Margin="15,0" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Engine Version" Width="125" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Last Modified" Width="150" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Grid Grid.Column="4" Width="50"/>
                        </Grid>
                    </Border>
                </StackPanel>
        
                <!-- Projects Content -->
                <ScrollViewer Grid.Row="1">
                    <Grid>
                        <TextBlock Text="No projects found yet..." VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5" Margin="0,40,0,0" IsVisible="{Binding !Projects.Count}"/>

                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ProjectInfo">
                                    <Border BorderBrush="{StaticResource SecondaryBackground}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FavoriteCol"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="VersionCol"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DateCol"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="OptionsCol"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="40">
                                                <PathIcon Data="{StaticResource StarFilled}" Width="14" IsVisible="{Binding IsFavourite}" VerticalAlignment="Center"/>
                                            </Grid>

                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="15,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding EngineVersion}" Width="125" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Grid.Column="4" HorizontalAlignment="Center" Classes="contextMenuButton">
                                                <PathIcon Data="{StaticResource ContextMenu}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    
</UserControl>
