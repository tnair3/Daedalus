<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DaedalusLauncher.App"
             xmlns:local="using:DaedalusLauncher"
             xmlns:controls="using:DaedalusLauncher.Controls"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="Sora">avares://DaedalusLauncher/Assets/Fonts#Sora</FontFamily>
            <FontFamily x:Key="JetBrainsMono">avares://DaedalusLauncher/Assets/Fonts#JetBrains Mono</FontFamily>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DaedalusLauncher/Assets/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Core surfaces (dark theme) -->
            <SolidColorBrush x:Key="PrimaryBackground" Color="#0A0A0C"/>
            <SolidColorBrush x:Key="SecondaryBackground" Color="#151519"/>
            <SolidColorBrush x:Key="SidebarBackground" Color="#0D0D10"/>
            <SolidColorBrush x:Key="TopBarBackground" Color="#0D0D10"/>
            <SolidColorBrush x:Key="CardBackground" Color="#17171B"/>
            <SolidColorBrush x:Key="CardBackgroundHover" Color="#1D1D22"/>
            <SolidColorBrush x:Key="CardBackgroundSelected" Color="#1F1F33"/>
            <SolidColorBrush x:Key="SeparatorColour" Color="#232328"/>
            
            <!-- Text -->
            <SolidColorBrush x:Key="PrimaryText" Color="#E5E6EA"/>
            <SolidColorBrush x:Key="SecondaryText" Color="#8B8D97"/>
            <SolidColorBrush x:Key="PrimaryHoverText" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SidebarHoverBackground" Color="#1B1B20"/>
            
            <!-- Accent - #6788c9 family -->
            <SolidColorBrush x:Key="ApplicationAccent" Color="#6788C9"/>
            <SolidColorBrush x:Key="ApplicationAccentAlt" Color="#7D9BD6"/>
            <SolidColorBrush x:Key="ApplicationAccentDark" Color="#43598F"/>
            <SolidColorBrush x:Key="ApplicationAccentMuted" Color="#28344F"/>
            <SolidColorBrush x:Key="ApplicationAccentSubtle" Color="#1B2338"/>

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#6788C9"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#7D9BD6"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#5573AC"/>
            
            <!-- Search / inputs -->
            <SolidColorBrush x:Key="AutoCompleteForeground" Color="#A6A8B2"/>
            <SolidColorBrush x:Key="AutoCompleteBackground" Color="#1C1C21"/>
            
            <!-- Status -->
            <SolidColorBrush x:Key="StatusSuccess" Color="#4CAF6E"/>
            <SolidColorBrush x:Key="SuccessOnHover" Color="#5FC281"/>
            <SolidColorBrush x:Key="StatusSuccessAlt" Color="#3D8A58"/>
            <SolidColorBrush x:Key="StatusWarning" Color="#EAB308"/>
            <SolidColorBrush x:Key="StatusError" Color="#D15B5B"/>
            <SolidColorBrush x:Key="StatusErrorAlt" Color="#8A3A3A"/>
            
            <!-- Tab bar -->
            <SolidColorBrush x:Key="TabActiveBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TabInactiveBackground" Color="#0D0D10"/>
            <SolidColorBrush x:Key="TabHoverBackground" Color="#1B1B20"/>
            <SolidColorBrush x:Key="TabActiveIndicator" Color="#6788C9"/>
            <SolidColorBrush x:Key="TabInactiveText" Color="#8B8D97"/>
        </ResourceDictionary>
    </Application.Resources>
     
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Styles/AppDefaultStyles.axaml"/>
        
        <Style Selector="Window">
            <Setter Property="WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBackground}"/>
        </Style>
        
        <Style Selector="controls|WindowFrame">
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel LastChildFill="True" Background="{StaticResource SidebarBackground}">
                        <Grid Height="50" ColumnDefinitions="20, *, Auto, 20" DockPanel.Dock="Top" Background="Transparent" PointerPressed="TitleBar_PointerPressed">
                            <TextBlock Grid.Column="1" Text="{TemplateBinding WindowName}" Foreground="{StaticResource PrimaryText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Padding="5, 0"/>
                
                            <Button Grid.Column="2" Command="{TemplateBinding CloseWindowCommand}" CommandParameter="{Binding $parent[Window]}" Classes="closeButton" Padding="5, 0"/>
                        </Grid>
            
                        <Border Width="20" DockPanel.Dock="Left"/>
                        <Border Width="20" DockPanel.Dock="Right"/>
                        <Border Height="20" DockPanel.Dock="Bottom"/>
            
                        <Border Background="{StaticResource PrimaryBackground}" CornerRadius="8" ClipToBounds="True" Padding="15">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>