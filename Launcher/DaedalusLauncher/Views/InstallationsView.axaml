<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DaedalusLauncher.Views.InstallationsView">
    
    <Grid Background="{StaticResource PrimaryBackground}" RowDefinitions="Auto, *">
        <TextBlock Grid.Row="0" Text="Installations" FontSize="24" Margin="20"/>
        <ScrollViewer Grid.Row="1">
            <TextBlock Text="Nothing to install yet..." VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
        </ScrollViewer>
    </Grid>
    
</UserControl>
