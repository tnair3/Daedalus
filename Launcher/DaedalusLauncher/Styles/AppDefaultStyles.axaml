<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource SidebarBackground}">
            <!-- Add Controls for Previewer Here -->
            <Button Content="Hello World" Classes="sidebar"/>
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource SoraFont}"/>
    </Style>
    
    <Style Selector="Button.sidebar">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>
    
        
    <Style Selector="Button.sidebar[Tag=True] /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryHoverText}"/>
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBackground}"/>
    </Style>
    
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.sidebar:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryHoverText}"/>
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBackground}"/>
    </Style>
    
    <Style Selector="Button.sidebar:pressed /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryHoverText}"/>
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBackground}"/>
    </Style>
    
    <Style Selector="Label.sidebar">
        <Setter Property="Padding" Value="10, 0, 0, 0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="14"/>
    </Style>
</Styles>
